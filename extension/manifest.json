{
  "manifest_version": 3,
  "name": "RustWarden",
  "version": "0.3.0",
  "description": "Schlanker, Bitwarden-kompatibler Passwort-Manager mit Rust/WASM-Kern.",
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png",
    "256": "icons/256.png",
    "512": "icons/512.png"
  },
  "action": {
    "default_title": "RustWarden",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "scripts": [
      "wasm/rw_core.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    },
    "autofill": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Passenden Login auf der aktuellen Seite ausfüllen"
    }
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inline.html",
        "inline.js",
        "passkey.html",
        "passkey.js",
        "passkey-page.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
